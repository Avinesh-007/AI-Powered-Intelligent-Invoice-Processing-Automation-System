# ==============================================================================
# AI-Powered Intelligent Invoice Processing & Automation System
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Settings
APP_NAME="AI-Powered Intelligent Invoice Processing & Automation System"
APP_ENV=development
DEBUG=True

# API Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/database/invoices.db

# Storage & File Processing Paths
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# Security & Validation Limits
MAX_UPLOAD_SIZE_MB=10

# OCR Engine Configuration (Leave blank to use system PATH or default Windows install path)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# AI / External API Keys (Do not commit actual keys to source control)
GEMINI_API_KEY=
